{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "5 * * * *"
    }
  ]
}
