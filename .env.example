# Copy to .env.local and fill in. Never commit real values.

# Leave empty in development to use the embedded PGlite database in .data/.
# Production: set by docker-compose.yml from POSTGRES_PASSWORD (Postgres service in Coolify).
DATABASE_URL=

# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `pnpm db:seed` to create the root account locally.
SEED_ROOT_EMAIL=
SEED_ROOT_PASSWORD=

# E-mail through any SMTP provider (ADR-004). Leave SMTP_HOST empty in development:
# e-mails are printed to the console. Port 587 uses STARTTLS; set SMTP_SECURE=true for 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Moonlang <ola@moonlang.com.br>"
# Replies from students go to the teacher's personal address.
EMAIL_REPLY_TO=

# Bearer token for scheduled jobs (/api/cron/*), shared by web and scheduler. At least 32 characters.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Only in Coolify (docker-compose.yml) ---
# Database password: letters and digits only (it goes into a URL). openssl rand -hex 32
POSTGRES_PASSWORD=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
CLOUDFLARE_TUNNEL_TOKEN=
# Days of daily database backups to keep.
BACKUP_KEEP_DAYS=14
