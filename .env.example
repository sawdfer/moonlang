# Copy to .env.local and fill in. Never commit real values.

# Leave empty in development to use the embedded PGlite database in .data/.
# Production: Neon connection string (region sa-east-1).
DATABASE_URL=

# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `pnpm db:seed` to create the root account locally.
SEED_ROOT_EMAIL=
SEED_ROOT_PASSWORD=

# E-mail through Resend (F-008). Leave empty in development: e-mails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="Moonlang <ola@moonlang.com.br>"

# Bearer token for scheduled jobs (/api/cron/billing, /api/cron/reminders). At least 32 characters.
# Generate with: openssl rand -base64 32
CRON_SECRET=
